<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
    <include layout="@layout/view_topbar" />
    <LinearLayout android:id="@+id/rowPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_shield" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Privacy &amp; Security" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/rowPrivacySub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile name, clear data" android:textColor="@color/sub" android:textSize="13sp" />
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron" />
    </LinearLayout>
    <LinearLayout android:id="@+id/rowRelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_bolt" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relay Mode" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/rowRelaySub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automatic" android:textColor="@color/sub" android:textSize="13sp" />
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swRelay" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/rowStore" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_database" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Store &amp; Forward" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/rowStoreSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable to save messages" android:textColor="@color/sub" android:textSize="13sp" />
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swStore" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/rowAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_info" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="About Mesh Chat" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/rowAboutSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Info &amp; Updates" android:textColor="@color/sub" android:textSize="13sp" />
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/btnLeave" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_card" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_exit" />
        <TextView android:id="@+id/leaveLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Leave Mesh Network" android:textColor="@color/ink" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
